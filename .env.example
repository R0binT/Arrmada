# Optional — personal LAN self-builds only.
# Copy to `.env` and fill all four values to skip onboarding on first launch.
# Values are inlined into the JS bundle; do not commit a filled `.env`.

EXPO_PUBLIC_RADARR_URL=http://192.168.1.10:7878
EXPO_PUBLIC_RADARR_API_KEY=

EXPO_PUBLIC_SONARR_URL=http://192.168.1.10:8989
EXPO_PUBLIC_SONARR_API_KEY=

# Optional — enables franchise/universe search on Add screens.
# Free key: https://www.themoviedb.org/settings/api
# GitHub Release APKs use a repo Actions secret of the same name
# (see docs/maintainers/releases.md).
EXPO_PUBLIC_TMDB_API_KEY=
